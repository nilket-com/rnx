pub fn main(args) {
	let input = polars::Series::from_iter_option_str([Some("1")])?
		.cast(polars::DataType::Int64())?.new_from_index(0, 10000)?;
	let k = polars::column_kernel("pub fn map(x) { x + 1 }", "map", ["i64"], "i64")?;
	println!("COLUMN_ENTER");
	let output = match k.map([input]) {
		Ok(output) => output,
		Err(error) => { println!("COLUMN_CAUGHT {error}"); return Ok(()); }
	};
	let expected = polars::Series::from_iter_option_str([Some("2")])?
		.cast(polars::DataType::Int64())?.new_from_index(0, 10000)?;
	assert!(output.equals(expected));
	assert_eq!(output.len()?, 10000);
	println!("COLUMN_OK {}", k.last_path());
	Ok(())
}
