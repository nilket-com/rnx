struct Accumulator { total, values }
impl Accumulator {
	fn bump(self, index) {
		let value = self.values[index] + 1;
		self.values[index] = value;
		value
	}
	fn visit(self, n) {
		if n > 0 {
			let value = self.bump(n % 4);
			self.total = self.total + value;
			self.visit(n - 1);
		}
	}
}
fn kernel(seed) {
	let accumulator = Accumulator { total: 0, values: [1, 2, 3, 4] };
	accumulator.visit(100 + seed % 7);
	accumulator.total
}
