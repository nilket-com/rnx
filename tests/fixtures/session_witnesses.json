  {
    "name": "prelude_tests::a_closure_captures_a_restored_binding_and_keeps_seeing_it",
    "actions": [
      {
        "budget": "max"
      },
      {
        "input": "let counter = [0];",
        "expect": {
          "outcome": "ok",
          "value": null
        }
      },
      {
        "input": "let bump = || counter.push(1);",
        "expect": {
          "outcome": "ok",
          "value": null
        }
      },
      {
        "input": "let unrelated = 0;",
        "expect": {
          "outcome": "ok"
        },
        "repeat": 10
      },
      {
        "input": "bump(); bump();",
        "target": {
          "ordinal": 3,
          "blocked_by": "unclassified site 2",
          "stdout": ""
        },
        "expect": {
          "outcome": "ok",
          "value": null
        }
      },
      {
        "input": "counter",
        "target": {
          "ordinal": 4,
          "blocked_by": "unclassified site 2",
          "stdout": ""
        },
        "expect": {
          "outcome": "ok",
          "value": "[0, 1, 1]"
        }
      }
    ]
  },
